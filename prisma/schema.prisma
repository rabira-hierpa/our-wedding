// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guest {
  id               String   @id @default(uuid())
  telegramUserId   BigInt   @map("telegram_user_id")
  telegramUsername String?  @map("telegram_username")
  firstName        String   @map("first_name")
  lastName         String?  @map("last_name")
  registeredAt     DateTime @default(now()) @map("registered_at")
  inWeddingGroup   Boolean  @default(false) @map("in_wedding_group")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  photos Photo[]
  wishes Wish[]
  likes  Like[]

  @@index([telegramUserId])
  @@map("guests")
}

model Photo {
  id                String   @id @default(uuid())
  guestId           String   @map("guest_id")
  storagePath       String   @map("storage_path")
  publicUrl         String   @map("public_url")
  telegramFileId    String   @map("telegram_file_id")
  groupMessageId    String?  @map("group_message_id") // Track message in group for deletion
  caption           String?
  isHidden          Boolean  @default(false) @map("is_hidden")
  uploadedAt        DateTime @default(now()) @map("uploaded_at")
  createdAt         DateTime @default(now()) @map("created_at")

  guest Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  likes Like[]

  @@index([guestId])
  @@index([uploadedAt(sort: Desc)])
  @@index([isHidden])
  @@map("photos")
}

model Wish {
  id        String   @id @default(uuid())
  guestId   String   @map("guest_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([createdAt(sort: Desc)])
  @@map("wishes")
}

model Like {
  id        String   @id @default(uuid())
  photoId   String   @map("photo_id")
  guestId   String   @map("guest_id")
  createdAt DateTime @default(now()) @map("created_at")

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([photoId, guestId])
  @@index([photoId])
  @@index([guestId])
  @@map("likes")
}
