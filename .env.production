# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# For Coolify Deployment on Hostinger VPS
# ========================================

# ----------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# ----------------------------------------
# IMPORTANT: Use the INTERNAL connection string from Coolify
#
# Steps to get this:
# 1. Go to Coolify Dashboard → Your Project → Dev Environment → Databases
# 2. Click on your PostgreSQL database
# 3. Copy the "Internal" connection string (NOT the external one)
# 4. It should look like: postgresql://postgres:RANDOM_PASSWORD@service-name:5432/postgres
#
# Example formats:
# - Coolify internal: postgresql://postgres:abc123xyz@wedding-gallery-db:5432/postgres
# - With schema: postgresql://postgres:abc123xyz@wedding-gallery-db:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:REPLACE_WITH_COOLIFY_PASSWORD@REPLACE_WITH_SERVICE_NAME:5432/postgres?schema=public"

# ----------------------------------------
# STORAGE CONFIGURATION
# ----------------------------------------
# Path where uploaded photos will be stored inside the Docker container
# This should match the volume mount path in Coolify (default: /app/public/uploads)
STORAGE_DIR=/app/public/uploads

# ----------------------------------------
# APPLICATION URL
# ----------------------------------------
# Your application's public URL
#
# Options:
# 1. Coolify Magic DNS: http://YOUR_VPS_IP.sslip.io
# 2. Custom subdomain: https://dev-wedding.yourdomain.com
# 3. Custom domain: https://wedding.yourdomain.com
#
# For HTTPS, Coolify can automatically provision SSL certificates
NEXT_PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN

# ----------------------------------------
# TELEGRAM BOT CONFIGURATION
# ----------------------------------------
# Get your bot token from @BotFather on Telegram
# Steps:
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow instructions
# 3. Copy the token provided
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# Generate a random secret for webhook verification
# Run this command to generate: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# ----------------------------------------
# TELEGRAM GROUP CHAT (Optional)
# ----------------------------------------
# If you want photos to be forwarded to a wedding group chat
#
# Steps to get Group Chat ID:
# 1. Add your bot to the group
# 2. Send a message in the group
# 3. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# 4. Look for "chat":{"id":-1234567890} in the response
# 5. Copy that negative number
#
# Leave empty if you don't want group forwarding
WEDDING_GROUP_CHAT_ID=

# ----------------------------------------
# NODE.JS & NEXT.JS CONFIGURATION
# ----------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# ----------------------------------------
# COOLIFY DEPLOYMENT NOTES
# ----------------------------------------
#
# After setting these variables in Coolify:
# 1. Go to Application → Environment Variables
# 2. Add each variable above (except the comments)
# 3. Click "Save"
# 4. Deploy/Redeploy your application
#
# To run database migrations after first deployment:
# 1. Go to Application → Terminal (or SSH into VPS)
# 2. Run: npx prisma migrate deploy
#
# Health Check Endpoint: /api/health
# Use this in Coolify for health monitoring
# ----------------------------------------
