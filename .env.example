# Database Configuration (PostgreSQL)
# For Coolify: Copy the EXACT "Internal" connection string from your database in Coolify
# It will look like: postgresql://postgres:AUTO_GENERATED_PASSWORD@wedding-gallery-db:5432/postgres
# For local development: postgresql://postgres:password@localhost:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres?schema=public"

# Storage Configuration
# For Coolify/Docker: /app/public/uploads
# For local: /var/www/wedding-photos or leave default (public/uploads)
STORAGE_DIR=/app/public/uploads
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-secret-string

# Optional: Wedding Group Chat (photos will be forwarded here)
WEDDING_GROUP_CHAT_ID=your-group-chat-id
